{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openworld-city-realtime",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
